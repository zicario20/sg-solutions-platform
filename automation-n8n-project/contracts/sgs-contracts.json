{
  "intent_output_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "IntentOutput",
    "type": "object",
    "required": [
      "language",
      "intent",
      "confidence",
      "service",
      "requires_tool",
      "tool",
      "missing_information",
      "response",
      "handoff_required"
    ],
    "properties": {
      "language": { "type": "string", "enum": ["es", "en"] },
      "intent": {
        "type": "string",
        "enum": [
          "GREETING",
          "GENERAL_QUESTION",
          "SERVICE_INFORMATION",
          "SERVICE_RECOMMENDATION",
          "PRICING_QUESTION",
          "CREDIT_SERVICE",
          "TAX_SERVICE",
          "BUSINESS_FORMATION",
          "BUSINESS_FUNDING",
          "LOAN_PREPARATION",
          "HOME_BUYING",
          "DOCUMENT_REQUIREMENTS",
          "APPOINTMENT_REQUEST",
          "CHECK_AVAILABILITY",
          "BOOK_APPOINTMENT",
          "RESCHEDULE_APPOINTMENT",
          "CANCEL_APPOINTMENT",
          "EXISTING_CUSTOMER",
          "SERVICE_STATUS",
          "PAYMENT_QUESTION",
          "HUMAN_REQUEST",
          "COMPLAINT",
          "UNCLEAR",
          "OUT_OF_SCOPE"
        ]
      },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "service": { "type": "string" },
      "requires_tool": { "type": "boolean" },
      "tool": {
        "type": "string",
        "enum": ["KB_SEARCH", "SERVICE_CATALOG", "CALENDAR", "LEAD", "HUMAN_HANDOFF", "NONE"]
      },
      "missing_information": { "type": "array", "items": { "type": "string" } },
      "handoff_required": { "type": "boolean" },
      "response": { "type": "string" },
      "notes": { "type": "string" },
      "next_action": { "type": "string" },
      "selected_service": { "type": "string" },
      "routing_guard": {
        "type": "object",
        "properties": {
          "admin_only_needed": { "type": "boolean" },
          "requires_payment_verification": { "type": "boolean" }
        }
      }
    }
  },
  "lead_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LeadRecord",
    "type": "object",
    "required": ["name", "phone", "email", "preferred_language", "requested_service", "lead_source", "lead_status", "created_date", "last_interaction"],
    "properties": {
      "name": { "type": "string" },
      "phone": { "type": "string" },
      "email": { "type": "string" },
      "preferred_language": { "type": "string", "enum": ["es", "en"] },
      "requested_service": { "type": "string" },
      "lead_source": { "type": "string" },
      "conversation_summary": { "type": "string" },
      "lead_status": {
        "type": "string",
        "enum": ["NEW", "QUALIFYING", "QUALIFIED", "APPOINTMENT_BOOKED", "FOLLOW_UP", "CUSTOMER", "CLOSED"]
      },
      "appointment_status": { "type": "string" },
      "created_date": { "type": "string", "format": "date-time" },
      "last_interaction": { "type": "string", "format": "date-time" }
    }
  },
  "appointment_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "AppointmentObject",
    "type": "object",
    "required": ["customer_name", "email", "service", "timezone", "date", "start_time", "end_time", "status"],
    "properties": {
      "customer_name": { "type": "string" },
      "email": { "type": "string" },
      "phone": { "type": "string" },
      "service": { "type": "string" },
      "timezone": { "type": "string" },
      "date": { "type": "string", "format": "date" },
      "start_time": { "type": "string" },
      "end_time": { "type": "string" },
      "appointment_id": { "type": "string" },
      "status": { "type": "string", "enum": ["proposed", "confirmed", "rescheduled", "cancelled", "failed", "needs_confirmation"] }
    }
  },
  "session_state_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SessionState",
    "type": "object",
    "properties": {
      "session_id": { "type": "string" },
      "customer_id": { "type": "string" },
      "language": { "type": "string", "enum": ["es", "en"] },
      "current_intent": { "type": "string" },
      "current_service": { "type": "string" },
      "conversation_stage": { "type": "string" },
      "pending_action": { "type": "string" },
      "collected_fields": { "type": "object" },
      "last_messages": { "type": "array", "items": { "type": "string" } },
      "created_at": { "type": "string", "format": "date-time" },
      "updated_at": { "type": "string", "format": "date-time" }
    }
  },
  "service_catalog_item_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ServiceCatalogItem",
    "type": "object",
    "required": ["id", "name", "category", "description", "active", "requires_consultation", "appointment_type", "required_documents", "faq_tags"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "category": { "type": "string" },
      "description": { "type": "string" },
      "active": { "type": "boolean" },
      "price": { "type": ["number", "null"] },
      "requires_consultation": { "type": "boolean" },
      "appointment_type": { "type": "string" },
      "required_documents": { "type": "array", "items": { "type": "string" } },
      "faq_tags": { "type": "array", "items": { "type": "string" } }
    }
  },
  "kb_query_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "KBSearchInput",
    "type": "object",
    "required": ["query", "language"],
    "properties": {
      "query": { "type": "string" },
      "service": { "type": "string" },
      "language": { "type": "string", "enum": ["es", "en"] }
    }
  },
  "kb_result_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "KBSearchOutput",
    "type": "object",
    "required": ["found", "results", "confidence"],
    "properties": {
      "found": { "type": "boolean" },
      "results": { "type": "array", "items": { "type": "object" } },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
    }
  },
  "human_handoff_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "HumanHandoffOutput",
    "type": "object",
    "required": ["handoff_required", "reason", "priority", "conversation_summary"],
    "properties": {
      "handoff_required": { "type": "boolean", "enum": [true] },
      "reason": { "type": "string" },
      "priority": { "type": "string", "enum": ["low", "normal", "high"] },
      "conversation_summary": { "type": "string" }
    }
  },
  "event_log_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ConversationLogEvent",
    "type": "object",
    "required": ["workflow_execution_id", "session_id", "customer_id", "channel", "intent", "selected_tool", "duration", "success", "timestamp"],
    "properties": {
      "workflow_execution_id": { "type": "string" },
      "session_id": { "type": "string" },
      "customer_id": { "type": "string" },
      "channel": { "type": "string" },
      "intent": { "type": "string" },
      "selected_tool": { "type": "string" },
      "duration": { "type": "number" },
      "success": { "type": "boolean" },
      "error_type": { "type": "string" },
      "timestamp": { "type": "string", "format": "date-time" }
    }
  }
}

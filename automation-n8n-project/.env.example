#
# SG Solutions n8n Chatbot — Environment configuration
# Replace only values marked with REPLACE_WITH_...
#

# Gateway + internal calls
SGS_WEBHOOK_BASE_URL=http://localhost:5678/webhook
SGS_INTERNAL_WEBHOOK_BASE_URL=http://localhost:5678/webhook
SGS_MAIN_WEBHOOK_PATH=/sgs/chat

# LLM (Qwen3:14B) integration in your existing infra
SGS_QWEN_CLASSIFIER_URL=https://REPLACE_WITH_QWEN_CHAT_URL
SGS_QWEN_RESPONSE_URL=https://REPLACE_WITH_QWEN_CHAT_URL
SGS_QWEN_CLASSIFIER_MODEL=qwen3-14b
SGS_QWEN_RESPONSE_MODEL=qwen3-14b
SGS_QWEN_API_KEY=

# Session service (optional)
SGS_SESSION_API_URL=
SGS_SESSION_API_AUTH_TOKEN=

# Calendar / scheduling
SGS_CALENDAR_API_URL=https://REPLACE_WITH_CALENDAR_BASE_URL
SGS_CALENDAR_API_KEY=

# CRM / Lead store
SGS_CRM_API_URL=https://REPLACE_WITH_CRM_API_URL
SGS_CRM_API_KEY=
SGS_CRM_LEADS_PATH=/leads

# Knowledge Base
SGS_KB_API_URL=
SGS_KB_API_KEY=

# Service catalog source (static -> leave blank and use data/service-catalog.json, or provide API)
SGS_SERVICE_CATALOG_URL=
SGS_SERVICE_CATALOG_API_KEY=
SGS_SERVICE_CATALOG_SOURCE=static

# Human handoff
SGS_HUMAN_INBOX_WEBHOOK=https://REPLACE_WITH_HUMAN_INBOX_WEBHOOK
SGS_HUMAN_PRIORITY_HIGH_WORDS=

# Logging / observability
SGS_LOGGING_API_URL=https://REPLACE_WITH_LOGGING_API
SGS_LOGGING_API_KEY=

# Workflow behavior
SGS_DEFAULT_LANGUAGE=es
SGS_SUPPORTED_LANGUAGES=es,en
SGS_DEFAULT_TIMEZONE=America/Chicago
SGS_MAX_TOOL_RETRIES=1
SGS_DEFAULT_APPOINTMENT_DURATION_MINUTES=60
SGS_COMPANY_NAME=SG Solutions

---
import { SITE_CHROME } from "../content/site-chrome";
import type { Locale, RouteKey } from "../domain/public-site";
import { getAlternatePath } from "../lib/routes";

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  compact?: boolean;
}

const { locale, routeKey, compact = false } = Astro.props;
const alternateLocale = locale === "es" ? "en" : "es";
---

<a
  class:list={["language-switcher", { "language-switcher--compact": compact }]}
  href={getAlternatePath(routeKey, alternateLocale)}
  hreflang={alternateLocale}
  lang={alternateLocale}
  aria-label={SITE_CHROME[locale].language}
>
  <span aria-hidden="true">{alternateLocale.toUpperCase()}</span>
  <span>{SITE_CHROME[locale].language}</span>
</a>

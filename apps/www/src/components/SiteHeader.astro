---
import { getChromeBySurface } from "../content/site-chrome";
import type { PublicPage } from "../domain/public-site";
import ActionLink from "./ActionLink.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LogoLockup from "./LogoLockup.astro";

interface Props {
  page: PublicPage;
}

const { page } = Astro.props;
const copy = getChromeBySurface(page.locale, page.surface);
const homeHref = page.surface === "client"
  ? page.locale === "es" ? "/client/dashboard/" : "/en/client/dashboard/"
  : page.surface === "admin"
    ? page.locale === "es" ? "/admin/dashboard/" : "/en/admin/dashboard/"
    : page.locale === "es" ? "/" : "/en/";

const isActive = (href: string) =>
  href === (page.locale === "es" ? "/" : "/en/") ? page.path === href : page.path.startsWith(href);

const renderMobilePrimaryAction = () => {
  if (page.surface === "admin") {
    return (
      <a class="action-link action-link--primary" href={homeHref}>
        {page.locale === "es" ? "Panel interno" : "Admin dashboard"}
      </a>
    );
  }

  return <ActionLink action="clientPortal" locale={page.locale} variant="secondary" />;
};
---

<header class="site-header">
    <div class="utility-bar">
      <div class="site-container utility-bar__inner">
        <p>{copy.assistance}</p>
        {page.surface === "admin" ? <a href={homeHref}>{copy.portal}</a> : <ActionLink action="clientPortal" locale={page.locale} variant="text" />}
      </div>
    </div>
    <div class="site-container header-main">
      <a class="brand-home" href={homeHref} aria-label="SG Solutions">
        <LogoLockup compact />
      </a>

    <nav class="desktop-nav" aria-label={copy.primaryNavLabel}>
      <ul>
        {
          copy.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <LanguageSwitcher locale={page.locale} routeKey={page.routeKey} compact />
      {page.surface === "public" && <ActionLink action="evaluation" locale={page.locale} />}
      {page.surface === "client" && <ActionLink action="evaluation" locale={page.locale} />}
      {page.surface === "admin" && <a class="action-link action-link--primary" href={homeHref}>{page.locale === "es" ? "Clientes" : "Clients"}</a>}
    </div>

    <details class="mobile-nav" data-mobile-navigation>
      <summary
        aria-label={copy.menu}
        aria-controls="mobile-navigation-panel"
        aria-expanded="false"
      >
        <span class="mobile-nav__icon" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="sr-only">{copy.menu}</span>
      </summary>
      <div class="mobile-nav__panel" id="mobile-navigation-panel">
        <div class="mobile-nav__top">
          <span>{copy.mobileNavTitle}</span>
          <span aria-hidden="true">×</span>
        </div>
        <nav aria-label={copy.mobileNavLabel}>
          <ul>
            {
              copy.nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                    {item.label}<span aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <LanguageSwitcher locale={page.locale} routeKey={page.routeKey} />
        {renderMobilePrimaryAction()}
        {page.surface === "admin" ? null : <ActionLink action="evaluation" locale={page.locale} />}
      </div>
    </details>
  </div>
</header>

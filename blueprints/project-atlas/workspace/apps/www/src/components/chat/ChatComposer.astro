---
interface Props {
  placeholder: string;
  send: string;
  characterCount: string;
}
const { placeholder, send, characterCount } = Astro.props;
---

<form class="public-chat-composer" data-public-chat-composer hidden novalidate>
  <label class="sr-only" for="public-chat-message">{placeholder}</label>
  <textarea
    id="public-chat-message"
    name="message"
    rows="2"
    maxlength="2000"
    placeholder={placeholder}
    autocomplete="off"
    enterkeyhint="send"
    data-public-chat-input
  ></textarea>
  <div class="public-chat-composer__footer">
    <span class="public-chat-count" data-public-chat-count>2000 {characterCount}</span>
    <button class="public-chat-send" type="submit" data-public-chat-send>{send}</button>
  </div>
</form>

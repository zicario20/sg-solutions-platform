---
import type { ChatLocale } from "@atlas/domain";
import { PUBLIC_CHAT_COPY } from "../../content/public-chat.ts";
import ChatComposer from "./ChatComposer.astro";
import ChatSources from "./ChatSources.astro";
import ChatTranscript from "./ChatTranscript.astro";

interface Props {
  locale: ChatLocale;
  mode: "floating" | "page";
}
const { locale, mode } = Astro.props;
const copy = PUBLIC_CHAT_COPY[locale];
const helpPath = locale === "es" ? "/recursos/" : "/en/resources/";
const contactPath = locale === "es" ? "/contacto/" : "/en/contact/";
const alternatePath = locale === "es" ? "/en/chat/" : "/chat/";
const fullPagePath = locale === "es" ? "/chat/" : "/en/chat/";
---

<section
  id="public-chat-panel"
  class:list={["public-chat-panel", { "public-chat-panel--page": mode === "page" }]}
  role="dialog"
  aria-modal={mode === "floating" ? "true" : "false"}
  aria-labelledby="public-chat-title"
  data-public-chat-panel
  data-public-chat-mode={mode}
  hidden={mode === "floating"}
>
  <header class="public-chat-header">
    <div class="public-chat-identity" aria-hidden="true">SG</div>
    <div>
      <p class="public-chat-kicker">{copy.ui.automated}</p>
      <h2 id="public-chat-title">{copy.ui.title}</h2>
    </div>
    <a class="public-chat-language" href={alternatePath} hreflang={locale === "es" ? "en" : "es"}>
      {copy.ui.language}
    </a>
    {
      mode === "floating" && (
        <button class="public-chat-close" type="button" aria-label={copy.ui.close} data-public-chat-dismiss>
          <span aria-hidden="true">×</span>
        </button>
      )
    }
  </header>

  <div class="public-chat-status" role="status" aria-live="polite" aria-atomic="true" data-public-chat-status>
    {copy.ui.statusReady}
  </div>

  <div class="public-chat-body">
    <div class="public-chat-notice" data-public-chat-notice>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 19h18.4L12 3Zm0 5.2v5.2m0 3.2h.01"></path></svg>
      <p>{copy.notice}</p>
    </div>

    <div class="public-chat-consent" data-public-chat-consent>
      <label>
        <input type="checkbox" data-public-chat-acknowledge />
        <span>{copy.ui.acknowledge}</span>
      </label>
      <button type="button" data-public-chat-start disabled>{copy.ui.start}</button>
    </div>

    <ChatTranscript greeting={copy.greeting} automated={copy.ui.automated} />

    <div class="public-chat-quick-actions" data-public-chat-actions hidden>
      <button type="button" data-public-chat-prompt={copy.quickActions.services}>{copy.quickActions.services}</button>
      <button type="button" data-public-chat-prompt={copy.quickActions.credit}>{copy.quickActions.credit}</button>
      <button type="button" data-public-chat-prompt={copy.quickActions.taxes}>{copy.quickActions.taxes}</button>
    </div>

    <ChatSources heading={copy.ui.sources} />
    <ChatComposer
      placeholder={copy.ui.placeholder}
      send={copy.ui.send}
      characterCount={copy.ui.characterCount}
    />
  </div>

  <footer class="public-chat-footer">
    <button type="button" class="public-chat-human" data-public-chat-human>
      {copy.quickActions.human}
    </button>
    <a href={helpPath}>{copy.ui.helpCenter}</a>
    {mode === "floating" && <a href={fullPagePath}>{copy.ui.fullPage}</a>}
    <a class="sr-only" href={contactPath}>Contact SG Solutions</a>
  </footer>

  <script type="application/json" data-public-chat-copy set:html={JSON.stringify({
    locale,
    copy,
    paths: { help: helpPath, contact: contactPath },
  })}></script>
</section>

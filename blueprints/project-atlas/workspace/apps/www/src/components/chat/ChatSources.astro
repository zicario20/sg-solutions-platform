---
interface Props {
  heading: string;
}
const { heading } = Astro.props;
---

<section class="public-chat-sources" data-public-chat-sources hidden aria-labelledby="chat-sources-title">
  <h3 id="chat-sources-title" data-public-chat-sources-heading>{heading}</h3>
  <ul data-public-chat-source-list></ul>
</section>

---
interface Props {
  greeting: string;
  automated: string;
}
const { greeting, automated } = Astro.props;
---

<div class="public-chat-transcript" data-public-chat-transcript tabindex="0" aria-label={automated}>
  <article class="public-chat-message public-chat-message--assistant" data-chat-initial-message>
    <p class="public-chat-message__actor">{automated}</p>
    <p>{greeting}</p>
  </article>
</div>

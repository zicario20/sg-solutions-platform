---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  class="public-chat-launcher"
  type="button"
  aria-label={label}
  aria-controls="public-chat-panel"
  aria-expanded="false"
  data-public-chat-launcher
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M5 5.75h14v9.5H9l-4 3v-12.5Z"></path>
    <path d="M8 9h8M8 12h5"></path>
  </svg>
  <span>{label}</span>
</button>

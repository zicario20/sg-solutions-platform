<script is:inline>
(() => {
const root = document.getElementById("module-workbench");
  if (!root) return;
  const locale = root.dataset.locale === "en" ? "en" : "es";
  const route = root.dataset.route ?? "";
  const installModuleWorkbenchHtmlGuards = (scope: Element) => {
    const nativeInnerHTML = Object.getOwnPropertyDescriptor(Element.prototype, "innerHTML");
    const nativeInsertAdjacent = Element.prototype.insertAdjacentHTML;
    if (!nativeInnerHTML?.get || !nativeInnerHTML?.set || !nativeInsertAdjacent) return;
    const stateKey = "__sgWorkbenchHtmlSafe";
    if (typeof window !== "undefined" && (window as Record<string, unknown>)[stateKey] === true) return;

    const ALLOWED_TAGS = new Set(
      [
        "a",
        "article",
        "aside",
        "b",
        "br",
        "button",
        "code",
        "div",
        "em",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "hr",
        "i",
        "li",
        "ol",
        "p",
        "pre",
        "section",
        "span",
        "strong",
        "table",
        "tbody",
        "td",
        "tfoot",
        "th",
        "thead",
        "tr",
        "ul",
      ],
    );

    const sanitizeHtml = (value: unknown): string => {
      const unsafeAttr = (name: string, attrValue: string | null) => {
        const lowerName = name.toLowerCase();
        if (lowerName.startsWith("on")) return true;
        if (lowerName === "srcdoc" || lowerName === "style" || lowerName === "srcset" || lowerName === "xlink:href" || lowerName === "formaction" || lowerName === "poster") return true;
        if (
          (lowerName === "href" || lowerName === "src" || lowerName === "action") &&
          attrValue &&
          /^\s*(javascript:|data:|vbscript:)/i.test(attrValue)
        ) {
          return true;
        }
        return false;
      };

      const template = document.createElement("template");
      nativeInnerHTML.set!.call(template, String(value ?? ""));
      const queue: Node[] = Array.from(template.content.childNodes);

      for (const topLevelNode of queue) {
        const walk = (node: Node) => {
          if (node.nodeType === Node.ELEMENT_NODE) {
            const element = node as Element;
            const tag = element.tagName.toLowerCase();
            if (!ALLOWED_TAGS.has(tag)) {
              element.replaceWith(document.createTextNode(element.textContent || ""));
              return;
            }

            Array.from(element.attributes).forEach((attribute) => {
              if (unsafeAttr(attribute.name, attribute.value)) {
                element.removeAttribute(attribute.name);
              }
            });

            const normalizedHref = element.getAttribute("href");
            if (normalizedHref && /^\s*(javascript:|data:|vbscript:)/i.test(normalizedHref)) {
              element.removeAttribute("href");
            }

            const normalizedSrc = element.getAttribute("src");
            if (normalizedSrc && /^\s*(javascript:|data:|vbscript:)/i.test(normalizedSrc)) {

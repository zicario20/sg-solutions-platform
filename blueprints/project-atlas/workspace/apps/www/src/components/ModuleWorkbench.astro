---
import type { Locale, RouteKey, Surface } from "../domain/public-site";

interface Props {
  routeKey: RouteKey;
  locale: Locale;
  surface: Surface;
}

const { routeKey, locale, surface } = Astro.props;
const isSpanish = locale === "es";

const t = {
  helpCenterTitle: isSpanish ? "Centro de ayuda funcional" : "Interactive help center",
  chatTitle: isSpanish ? "Chat público en acción" : "Live public chat",
  chatSubtitle: isSpanish
    ? "Tu mensaje inicial se clasifica y se prepara un siguiente paso."
    : "Your first message is classified and a next step is prepared.",
  whatsappTitle: isSpanish ? "Simulador de WhatsApp Business" : "WhatsApp Business simulator",
  phoneTitle: isSpanish ? "Simulador de agente telefónico" : "Phone agent simulator",
  formsTitle: isSpanish ? "Formularios públicos con validación" : "Public forms with validation",
  authTitle: isSpanish ? "Acceso del cliente (demo local)" : "Client access (local demo)",
  dashboardTitle: isSpanish ? "Dashboard del cliente (demo)" : "Client dashboard (demo)",
  myServicesTitle: isSpanish ? "Mis servicios (demo)" : "My services (demo)",
  processStatusTitle: isSpanish ? "Estado de mi proceso (demo)" : "My process status (demo)",
  documentsTitle: isSpanish ? "Portal de documentos (demo)" : "Document portal (demo)",
  messagingTitle: isSpanish ? "Mensajería segura (demo)" : "Secure messaging (demo)",
  appointmentsTitle: isSpanish ? "Citas del cliente (demo)" : "Client appointments (demo)",
  billingTitle: isSpanish ? "Pagos y facturación (demo)" : "Billing and invoicing (demo)",
  profileTitle: isSpanish ? "Perfil financiero (demo)" : "Financial profile (demo)",
  adminDashboardTitle: isSpanish ? "Dashboard administrativo (demo)" : "Admin dashboard (demo)",
  crmTitle: isSpanish ? "CRM (demo)" : "CRM (demo)",
  clientManagementTitle: isSpanish ? "Gestión de clientes (demo)" : "Client management (demo)",
  companyManagementTitle: isSpanish ? "Gestión de empresas (demo)" : "Company management (demo)",
  leadManagementTitle: isSpanish ? "Gestión de leads (demo)" : "Lead management (demo)",
  serviceOrdersTitle: isSpanish ? "Órdenes de servicio (demo)" : "Service orders (demo)",
  formsCenterTitle: isSpanish ? "Centro de formularios (demo)" : "Forms center (demo)",
  workQueueTitle: isSpanish ? "Colas y tareas (demo)" : "Work queues and tasks (demo)",
  approvalsTitle: isSpanish ? "Aprobaciones humanas (demo)" : "Human approvals (demo)",
  aiHubTitle: isSpanish ? "AI Hub (demo)" : "AI Hub (demo)",
  operationsTitle: isSpanish ? "Operaciones y despliegue (demo)" : "Operations and deployment (demo)",
  governanceTitle: isSpanish ? "Gobernanza y cumplimiento (demo)" : "Governance and compliance (demo)",
  analyticsTitle: isSpanish ? "Analítica y riesgo operativo (demo)" : "Operational analytics and risk (demo)",
  tradelinesTitle: isSpanish ? "Marketplace de tradelines (demo)" : "Tradelines marketplace (demo)",
  taxServicesTitle: isSpanish ? "Servicios tributarios (demo)" : "Tax services (demo)",
  bookkeepingTitle: isSpanish
    ? "Bookkeeping y contabilidad (demo)"
    : "Bookkeeping and accounting (demo)",
};
const labels = {
  es: {
    searchPlaceholder: "Buscar",
    askPlaceholder: "Escribe tu pregunta",
    send: "Enviar",
    required: "Obligatorio",
    success: "Registro guardado",
    next: "Siguiente paso",
    action: "Acción",
    noMatch: "Sin coincidencias. Prueba con otra consulta.",
    logout: "Cerrar sesión",
    login: "Entrar",
    register: "Crear cuenta",
    language: "Idioma",
    noAuth:
      "Primero inicia sesión para usar este módulo de forma personal. Usa una cuenta en este demo local.",
    service: "Servicio",
    date: "Fecha",
    owner: "Responsable",
    status: "Estado",
    nextAction: "Próximo paso",
    documents: "Documentos",
    requests: "Solicitudes",
    attach: "Adjunto",
    send: "Enviar",
    save: "Guardar",
    create: "Crear",
    createInvoice: "Crear factura",
    createAppointment: "Agendar",
    timezone: "Zona horaria",
    channel: "Canal",
    type: "Tipo",
    paid: "Pagado",
    pending: "Pendiente",
    schedule: "Reagendar",
    cancel: "Cancelar",
    next: "Siguiente",
    actions: "Acciones",
    add: "Agregar",
    publish: "Publicar",
    archive: "Archivar",
    advance: "Avanzar",
    approve: "Aprobar",
    reject: "Rechazar",
    requestInfo: "Solicitar info",
    run: "Ejecutar",
    queued: "En cola",
    complete: "Completar",
    close: "Cerrar",
    review: "Revisar",
  },
  en: {
    searchPlaceholder: "Search",
    askPlaceholder: "Type your message",
    send: "Send",
    required: "Required",
    success: "Record saved",
    next: "Next step",
    action: "Action",
    noMatch: "No matches. Try another phrase.",
    logout: "Sign out",
    login: "Sign in",
    register: "Create account",
    language: "Language",
    noAuth:
      "Sign in first to use this module with personalized context. This is a local demo only.",
    service: "Service",
    date: "Date",
    owner: "Owner",
    status: "Status",
    nextAction: "Next action",
    documents: "Documents",
    requests: "Requests",
    attach: "Attachment",
    send: "Send",
    save: "Save",
    create: "Create",
    createInvoice: "Create invoice",
    createAppointment: "Book",
    timezone: "Timezone",
    channel: "Channel",
    type: "Type",
    paid: "Paid",
    pending: "Pending",
    schedule: "Reschedule",
    cancel: "Cancel",
    next: "Next",
    actions: "Actions",
    add: "Add",
    publish: "Publish",
    archive: "Archive",
    advance: "Advance",
    approve: "Approve",
    reject: "Reject",
    requestInfo: "Request info",
    run: "Run",
    queued: "Queued",
    complete: "Complete",
    close: "Close",
    review: "Review",
  },
};
const copy = labels[locale];
---

<div class="module-workbench" id="module-workbench" data-locale={locale} data-route={routeKey}>
  {routeKey === "help-center" && (
    <section class="module-card" id="module-help">
      <h2>{t.helpCenterTitle}</h2>
      <p>{isSpanish ? "Explora con búsqueda y filtros antes de escalar a un agente." : "Search and filter before escalating."}</p>
      <div class="module-controls">
        <input id="help-center-search" type="search" placeholder={copy.searchPlaceholder} />
        <select id="help-center-topic">
          <option value="all">{isSpanish ? "Todos" : "All"}</option>
          <option value="credito">{isSpanish ? "Crédito" : "Credit"}</option>
          <option value="taxes">{isSpanish ? "Taxes" : "Taxes"}</option>
          <option value="negocio">{isSpanish ? "Negocio" : "Business"}</option>
          <option value="vivienda">{isSpanish ? "Vivienda" : "Home buying"}</option>
        </select>
      </div>
      <div id="help-center-results" class="module-items"></div>
    </section>
  )}

  {routeKey === "admin-contacts" && (
    <section class="module-card" id="module-admin-contacts">
      <h2>{isSpanish ? "Contactos operativos (admin)" : "Operational contacts (admin)"}</h2>
      <p>
        {isSpanish
          ? "Gestiona chat, WhatsApp y llamadas en un solo panel."
          : "Manage chat, WhatsApp and calls from one panel."}
      </p>
      <section class="module-subcard">
        <h3>{t.chatTitle}</h3>
        <p>{t.chatSubtitle}</p>
        <div id="chat-window" class="chat-window">
          <p class="chat-bubble bot">
            {isSpanish
              ? "Hola 👋. Cuéntame tu objetivo y te ayudo a ubicar tu siguiente paso."
              : "Hi 👋. Share your goal and I will help place your next step."}
          </p>
        </div>
        <form id="chat-form" class="module-form">
          <label for="chat-message" class="sr-only">
            {isSpanish ? "Mensaje" : "Message"}
          </label>
          <input id="chat-message" name="message" type="text" placeholder={isSpanish ? "Escribe tu duda..." : "Type your question..."} />
          <button type="submit" class="action-link action-link--primary">{copy.send}</button>
        </form>
        <div id="chat-handoff" class="module-note"></div>
      </section>

      <section class="module-subcard">
        <h3>{t.whatsappTitle}</h3>
        <p>
          {isSpanish
            ? "Simulación de canal con estado, recordatorios y transferencias."
            : "Channel simulation with state, reminders and handoff."}
        </p>
        <form id="whatsapp-form" class="module-form">
          <select id="whatsapp-action">
            <option value="inbox">{"inbox"}</option>
            <option value="reminder">{isSpanish ? "recordatorio" : "reminder"}</option>
            <option value="appointment">{isSpanish ? "cita" : "appointment"}</option>
            <option value="handoff">{isSpanish ? "transferir a humano" : "handoff to human"}</option>
          </select>
          <input id="whatsapp-message" type="text" placeholder={isSpanish ? "Describe el motivo del contacto" : "Describe contact reason"} />
          <button type="submit" class="action-link action-link--primary">{isSpanish ? "Simular" : "Run"}</button>
        </form>
        <div id="whatsapp-log" class="module-note-list"></div>
      </section>

      <section class="module-subcard">
        <h3>{t.phoneTitle}</h3>
        <p>{isSpanish ? "Recibe y clasifica llamada simulada." : "Receive and classify incoming calls."}</p>
        <form id="phone-form" class="module-form">
          <input id="phone-name" type="text" placeholder={isSpanish ? "Nombre" : "Name"} required />
          <select id="phone-language">
            <option value="es">Español</option>
            <option value="en">English</option>
          </select>
          <textarea id="phone-note" rows={3} placeholder={isSpanish ? "Motivo de la llamada" : "Call reason"} />
          <button type="submit" class="action-link action-link--primary">{isSpanish ? "Registrar llamada" : "Register call"}</button>
        </form>
        <div id="phone-leads" class="module-note-list"></div>
      </section>
    </section>
  )}

  {routeKey === "public-forms" && (
    <section class="module-card" id="module-public-forms">
      <h2>{t.formsTitle}</h2>
      <p>{isSpanish ? "Formulario demo con validación y lead mínimo." : "Demo form with validation and lead capture."}</p>
      <form id="public-form" class="module-form">
        <input id="pf-name" type="text" placeholder={isSpanish ? "Nombre" : "Name"} required />
        <input id="pf-email" type="email" placeholder="Email" required />
        <input id="pf-phone" type="tel" placeholder={isSpanish ? "Teléfono" : "Phone"} />
        <select id="pf-service">
          <option value="credit">{isSpanish ? "Crédito" : "Credit"}</option>
          <option value="taxes">{isSpanish ? "Taxes" : "Taxes"}</option>
          <option value="business">{isSpanish ? "Negocio" : "Business"}</option>
          <option value="home">{isSpanish ? "Comprar casa" : "Home buying"}</option>
        </select>
        <textarea id="pf-message" rows={4} placeholder={isSpanish ? "Mensaje inicial" : "Initial message"} required />
        <button type="submit" class="action-link action-link--primary">{copy.required}</button>
      </form>
      <div id="public-form-summary" class="module-note"></div>
    </section>
  )}

  {routeKey === "portal-auth" && (
    <section class="module-card" id="module-portal-auth">
      <h2>{t.authTitle}</h2>
      <p>{copy.noAuth}</p>
      <div class="module-auth-tabs">
        <button type="button" data-auth-mode="signin" class="auth-tab active">{copy.login}</button>
        <button type="button" data-auth-mode="register" class="auth-tab">{copy.register}</button>
      </div>
      <form id="auth-form" class="module-form">
        <input id="auth-name" type="text" placeholder={isSpanish ? "Nombre" : "Name"} />
        <input id="auth-email" type="email" placeholder="Email" required />
        <input id="auth-password" type="password" placeholder={isSpanish ? "Contraseña" : "Password"} required />
        <button id="auth-submit" type="submit" class="action-link action-link--primary">{copy.login}</button>
      </form>
      <div id="auth-status" class="module-note"></div>
      <button id="auth-signout" type="button" class="action-link action-link--secondary" style="display:none;">
        {copy.logout}
      </button>
    </section>
  )}

  {routeKey === "customer-dashboard" && (
    <section class="module-card" id="module-dashboard">
      <h2>{t.dashboardTitle}</h2>
      <div id="dashboard-body"></div>
    </section>
  )}

  {routeKey === "my-services" && (
    <section class="module-card" id="module-my-services">
      <h2>{t.myServicesTitle}</h2>
      <div id="my-services-body"></div>
    </section>
  )}

  {routeKey === "process-status" && (
    <section class="module-card" id="module-status">
      <h2>{t.processStatusTitle}</h2>
      <p>{isSpanish ? "Estados del expediente del cliente (simulación local)." : "Local simulation of client process states."}</p>
      <div id="status-body" class="module-status-list"></div>
    </section>
  )}

  {routeKey === "portal-documents" && (
    <section class="module-card" id="module-documents">
      <h2>{t.documentsTitle}</h2>
      <p>{isSpanish ? "Carga y revisa documentos del cliente por tipo y estado." : "Upload and review client documents by type and status."}</p>
      <form id="portal-documents-form" class="module-form module-form--grid">
        <input id="document-name" type="text" placeholder={isSpanish ? "Nombre del documento" : "Document name"} required />
        <select id="document-type">
          <option value="id">{isSpanish ? "Identidad" : "ID"}</option>
          <option value="income">{isSpanish ? "Ingresos" : "Income"}</option>
          <option value="bank">{isSpanish ? "Estado bancario" : "Bank statement"}</option>
          <option value="tax">{isSpanish ? "Impuestos" : "Tax"}</option>
          <option value="legal">{isSpanish ? "Documentos legales" : "Legal docs"}</option>
        </select>
        <input id="document-owner" type="text" placeholder={isSpanish ? "Cliente" : "Client"} />
        <div class="module-form-actions">
          <button type="submit" class="action-link action-link--primary">{copy.add}</button>
          <button id="document-request-missing" type="button" class="action-link action-link--secondary">{isSpanish ? "Marcar documento faltante" : "Mark missing document"}</button>
        </div>
      </form>
      <div id="documents-missing"></div>
      <div id="documents-list" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "secure-messaging" && (
    <section class="module-card" id="module-messaging">
      <h2>{t.messagingTitle}</h2>
      <p>{isSpanish ? "Conversación del expediente con historial y nota automática." : "Case conversation with history and automated assistance notes."}</p>
      <form id="secure-message-form" class="module-form">
        <textarea id="secure-message" rows={3} placeholder={isSpanish ? "Escribe tu mensaje..." : "Type your message..."} required />
        <div class="module-form-actions">
          <button type="submit" class="action-link action-link--primary">{copy.send}</button>
          <button type="button" id="secure-message-ai" class="action-link action-link--secondary">
            {isSpanish ? "Simular nota IA" : "Simulate AI note"}
          </button>
          <button type="button" id="secure-message-handoff" class="action-link action-link--secondary">
            {isSpanish ? "Derivar a persona" : "Handoff to person"}
          </button>
        </div>
      </form>
      <div id="secure-message-list" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "client-appointments" && (
    <section class="module-card" id="module-appointments">
      <h2>{t.appointmentsTitle}</h2>
      <p>{isSpanish ? "Agenda citas y gestiona reprogramaciones o cancelaciones." : "Schedule and manage rescheduling or cancellation."}</p>
      <form id="appointments-form" class="module-form module-form--grid">
        <input id="appointment-title" type="text" placeholder={isSpanish ? "Motivo" : "Purpose"} required />
        <input id="appointment-date" type="datetime-local" />
        <select id="appointment-timezone">
          <option value="America/Los_Angeles">{isSpanish ? "Pacifico" : "Pacific"}</option>
          <option value="America/New_York">{isSpanish ? "Este" : "Eastern"}</option>
          <option value="Europe/Madrid">{isSpanish ? "Madrid" : "Madrid"}</option>
        </select>
        <select id="appointment-channel">
          <option value="video">{isSpanish ? "Videollamada" : "Video call"}</option>
          <option value="phone">{isSpanish ? "Teléfono" : "Phone"}</option>
          <option value="in-person">{isSpanish ? "Presencial" : "In person"}</option>
        </select>
        <button type="submit" class="action-link action-link--primary">{copy.createAppointment}</button>
      </form>
      <div id="appointment-body" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "client-billing" && (
    <section class="module-card" id="module-billing">
      <h2>{t.billingTitle}</h2>
      <p>{isSpanish ? "Estado financiero local de facturas, pagos y recibos simulados." : "Local financial state with invoices, payments and receipts."}</p>
      <form id="billing-form" class="module-form module-form--grid">
        <input id="invoice-label" type="text" placeholder={isSpanish ? "Descripción" : "Description"} required />
        <input id="invoice-amount" type="number" min="0" step="0.01" placeholder="USD" required />
        <select id="invoice-status">
          <option value="pending">{copy.pending}</option>
          <option value="paid">{copy.paid}</option>
        </select>
        <button type="submit" class="action-link action-link--primary">{copy.createInvoice}</button>
      </form>
      <div id="invoice-body" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "financial-profile" && (
    <section class="module-card" id="module-profile">
      <h2>{t.profileTitle}</h2>
      <p>{isSpanish ? "Perfil consolidado para demo local sin integrar servicios sensibles." : "Local consolidated profile without sensitive service integrations."}</p>
      <form id="financial-profile-form" class="module-form">
        <input id="profile-name" type="text" placeholder={isSpanish ? "Nombre completo" : "Full name"} />
        <input id="profile-income" type="text" placeholder={isSpanish ? "Ingresos estimados" : "Estimated income"} />
        <input id="profile-debts" type="text" placeholder={isSpanish ? "Deudas actuales" : "Current debts"} />
        <input id="profile-housing" type="text" placeholder={isSpanish ? "Objetivo de vivienda" : "Housing goal"} />
        <input id="profile-business" type="text" placeholder={isSpanish ? "Negocio actual" : "Current business"} />
        <textarea id="profile-objectives" rows={3} placeholder={isSpanish ? "Objetivos" : "Goals"} />
        <button type="submit" class="action-link action-link--primary">{copy.save}</button>
      </form>
      <div id="financial-profile-body" class="module-note"></div>
    </section>
  )}

  {routeKey === "admin-dashboard" && (
    <section class="module-card" id="module-admin-dashboard">
      <h2>{t.adminDashboardTitle}</h2>
      <p>{isSpanish ? "Vista de operación interna con datos de prueba locales." : "Internal operational snapshot using local test data."}</p>
      <div id="admin-dashboard-body" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "crm" && (
    <section class="module-card" id="module-crm">
      <h2>{t.crmTitle}</h2>
      <p>{isSpanish ? "Oportunidades y próximos pasos por contacto." : "Opportunities and next steps by contact."}</p>
      <form id="crm-form" class="module-form module-form--grid">
        <input id="crm-lead-name" type="text" placeholder={isSpanish ? "Nombre" : "Name"} />
        <select id="crm-service">
          <option value="credito">{isSpanish ? "Crédito" : "Credit"}</option>
          <option value="taxes">{isSpanish ? "Taxes" : "Taxes"}</option>
          <option value="negocio">{isSpanish ? "Negocio" : "Business"}</option>
          <option value="home">{isSpanish ? "Comprar casa" : "Home buying"}</option>
        </select>
        <input id="crm-next-action" type="text" placeholder={isSpanish ? "Próxima acción" : "Next action"} />
        <button type="submit" class="action-link action-link--primary">{copy.create}</button>
      </form>
      <div id="crm-body" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "client-management" && (
    <section class="module-card" id="module-clients">
      <h2>{t.clientManagementTitle}</h2>
      <p>{isSpanish ? "Control de clientes activos y estado de expediente." : "Manage active clients and case status."}</p>
      <form id="client-management-form" class="module-form module-form--grid">
        <input id="client-management-name" type="text" placeholder={isSpanish ? "Cliente" : "Client"} />
        <input id="client-management-email" type="email" placeholder="Email" />
        <input id="client-management-service" type="text" placeholder={isSpanish ? "Servicios" : "Services"} />
        <input id="client-management-note" type="text" placeholder={isSpanish ? "Nota" : "Note"} />
        <button type="submit" class="action-link action-link--primary">{copy.create}</button>
      </form>
      <div class="module-form">
        <input id="client-management-search" type="search" placeholder={copy.searchPlaceholder} />
      </div>
      <div id="client-management-body" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "company-management" && (
    <section class="module-card" id="module-companies">
      <h2>{t.companyManagementTitle}</h2>
      <p>{isSpanish ? "Ficha de empresa y estado legal para operaciones internas." : "Company profiles and legal state for internal operations."}</p>
      <form id="company-management-form" class="module-form module-form--grid">
        <input id="company-name" type="text" placeholder={isSpanish ? "Nombre de empresa" : "Company name"} />
        <input id="company-type" type="text" placeholder={isSpanish ? "Tipo de entidad" : "Entity type"} />
        <input id="company-ein" type="text" placeholder="EIN" />
        <input id="company-state" type="text" placeholder={isSpanish ? "Estado" : "State"} />
        <input id="company-industry" type="text" placeholder={isSpanish ? "Industria" : "Industry"} />
        <button type="submit" class="action-link action-link--primary">{copy.create}</button>
      </form>
      <div id="company-management-body" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "lead-management" && (
    <section class="module-card" id="module-leads">
      <h2>{t.leadManagementTitle}</h2>
      <p>{isSpanish ? "Scoring y conversión de leads con historial de estado." : "Lead scoring and conversion with status history."}</p>
      <form id="lead-form" class="module-form module-form--grid">
        <input id="lead-name" type="text" placeholder={isSpanish ? "Lead" : "Lead"} />
        <select id="lead-service">
          <option value="credito">{isSpanish ? "Crédito" : "Credit"}</option>
          <option value="taxes">{isSpanish ? "Taxes" : "Taxes"}</option>
          <option value="negocio">{isSpanish ? "Negocio" : "Business"}</option>
          <option value="home">{isSpanish ? "Comprar casa" : "Home buying"}</option>
        </select>
        <select id="lead-source">
          <option value="chat">{isSpanish ? "Chat" : "Chat"}</option>
          <option value="whatsapp">{isSpanish ? "WhatsApp" : "WhatsApp"}</option>
          <option value="form">{isSpanish ? "Formulario" : "Form"}</option>
          <option value="phone">{isSpanish ? "Teléfono" : "Phone"}</option>
        </select>
        <button type="submit" class="action-link action-link--primary">{copy.create}</button>
      </form>
      <div id="lead-body" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "service-orders" && (
    <section class="module-card" id="module-orders">
      <h2>{t.serviceOrdersTitle}</h2>
      <p>{isSpanish ? "Órdenes con ciclo y estado operativo completo." : "Orders with lifecycle and operational state."}</p>
      <form id="order-form" class="module-form module-form--grid">
        <input id="order-client" type="text" placeholder={isSpanish ? "Cliente" : "Client"} />
        <input id="order-service" type="text" placeholder={isSpanish ? "Servicio" : "Service"} />
        <input id="order-price" type="number" min="0" step="0.01" placeholder="USD" />
        <button type="submit" class="action-link action-link--primary">{copy.create}</button>
      </form>
      <div id="orders-body" class="module-note-list"></div>
    </section>
  )}

  {routeKey === "admin-forms" && (
    <section class="module-card" id="module-admin-forms">
      <h2>{t.formsCenterTitle}</h2>

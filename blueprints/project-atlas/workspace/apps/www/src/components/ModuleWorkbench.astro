      };
      createModuleItem("crm", STORAGE_KEYS.crm, payload, (items) => {
        const created = {
          id: uid("crm"),
          leadName: payload.leadName,
          service: payload.service,
          source: payload.source,
          owner: locale === "es" ? "Comercial interno" : "Internal sales",
          nextAction: payload.nextAction,
          stage: "new",
          status: "new",
          score: 0,
          converted: false,
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString(),
        };
        items.push(created);

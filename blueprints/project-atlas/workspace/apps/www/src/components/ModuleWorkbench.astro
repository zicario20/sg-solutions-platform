        canManageSetup: true,
        canPost: true,
        canReview: true,
      },
      bookkeeping_reviewer: {
        label: isSpanish ? "Revisor de bookkeeping" : "Bookkeeping reviewer",
        canManageSetup: true,
        canPost: true,
        canReview: true,
      },
      bookkeeping_manager: {
        label: isSpanish ? "Manager (autoriza y publica)" : "Manager (authorize + post)",
        canManageSetup: true,
        canPost: true,
        canReview: true,
      },
    };

    const getRole = () => String(roleSelect?.value || "bookkeeping_client");
    const permissionsFor = (value) => roleMatrix[value] || roleMatrix.bookkeeping_client;
    const normalBalanceByAccountType = (accountType) => {
      if (["asset", "expense", "other_expense"].includes(accountType)) return "debit";
      return "credit";
    };
    const toMoneyNum = (value) => {
      const amount = Number(String(value ?? "").trim());
      return Number.isFinite(amount) ? amount : 0;
    };
    const toText = (value) => String(value ?? "").trim();
    const bookNameById = (bookId) => accountingBooks.find((book) => book.id === bookId)?.bookName || "-";
    const entityNameById = (entityId) => accountingEntities.find((entry) => entry.id === entityId)?.displayName || "-";
    const updateRoleNote = () => {
      if (!roleNote) return;
      const perms = permissionsFor(getRole());
      roleNote.textContent = isSpanish
        ? `Rol actual: ${perms.label}. ${perms.canPost ? "Puede preparar/revisar/publicar." : perms.canReview ? "Puede revisar." : "Sin acción contable directa."}`
        : `Active role: ${perms.label}. ${perms.canPost ? "Can prepare/review/post." : perms.canReview ? "Can review." : "No direct accounting action."}`;
    };
    const serviceStatusLabel = (status) => (status || (isSpanish ? "borrador" : "draft"));
    const periodStatusLabel = (status) =>
      ({
        future: isSpanish ? "Futuro" : "Future",
        open: isSpanish ? "Abierto" : "Open",
        processing: isSpanish ? "Procesando" : "Processing",
        review: isSpanish ? "Revisión" : "Review",
        soft_closed: isSpanish ? "Cierre suave" : "Soft closed",
        closed: isSpanish ? "Cerrado" : "Closed",
        reopened: isSpanish ? "Reabierto" : "Reopened",
      }[status] || status);
    const journalStatusLabel = (status) =>
      ({
        draft: isSpanish ? "Borrador" : "Draft",
        proposed: isSpanish ? "Propuesto" : "Proposed",
        review_required: isSpanish ? "Revisión requerida" : "Review required",
        approved: isSpanish ? "Aprobado" : "Approved",
        posted: isSpanish ? "Publicado" : "Posted",
        reversed: isSpanish ? "Revertido" : "Reversed",
        voided: isSpanish ? "Anulado" : "Voided",
        superseded: isSpanish ? "Reemplazado" : "Superseded",
      }[status] || status);
    const verificationLabel = (status) =>
      ({
        unverified: isSpanish ? "Sin verificar" : "Unverified",
        partially_verified: isSpanish ? "Parcial" : "Partially verified",
        verified: isSpanish ? "Verificado" : "Verified",
        requires_review: isSpanish ? "Requiere revisión" : "Requires review",
        rejected: isSpanish ? "Rechazado" : "Rejected",
      }[status] || status);
    const ownershipLabel = (value) =>
      ({
        business_owned: isSpanish ? "Propiedad empresarial" : "Business owned",
        personal_used_for_business: isSpanish ? "Personal usado para negocio" : "Personal used for business",
        mixed_use: isSpanish ? "Uso mixto" : "Mixed use",
        third_party: isSpanish ? "Terceros" : "Third party",
        unknown: isSpanish ? "Desconocido" : "Unknown",
      }[value] || value);

    const nextNumber = (prefix) => `${prefix}-${String(Date.now()).slice(-7)}`;
    const getSortedBooks = () => [...accountingBooks].sort((a, b) => String(a.bookName || "").localeCompare(String(b.bookName || "")));
    const getPeriodsForBook = (bookId) => accountingPeriods.filter((entry) => entry.accountingBookId === bookId);
    const getAccountsForBook = (bookId) => chartAccounts.filter((entry) => entry.accountingBookId === bookId);
    const getDefaultClosePolicy = (value) => (value === "monthly" ? "policy-monthly" : value === "quarterly" ? "policy-quarterly" : "policy-annual");
    const nowStamp = () => new Date().toISOString();
    const appendAudit = (action, details) => {
      if (!Array.isArray(auditLog)) return;
      const record = {
        id: uid("bk-audit"),
        at: nowStamp(),
        role: getRole(),
        action,
        details: String(details ?? ""),
      };
      auditLog.unshift(record);
      if (auditLog.length > 120) auditLog.length = 120;
      saveJSON(STORAGE_KEYS.bookkeepingAuditLog, auditLog);
      renderAudit();
    };
    const ensureSystemBookSetup = (bookId) => {
      if (!bookId) return;
      const defaults = [
        {
          accountNumber: "1000",
          accountName: "Opening Balance Equity",
          accountType: "equity",
          accountSubtype: "capital_stock",
          normalBalance: "credit",
        },
        {
          accountNumber: "1100",
          accountName: "Suspense",
          accountType: "asset",
          accountSubtype: "other_current_asset",
          normalBalance: "debit",
        },
      ];
      defaults.forEach((entry) => {
        const exists = chartAccounts.find((row) => row.accountingBookId === bookId && row.accountNumber === entry.accountNumber);
        if (!exists) {
          chartAccounts.push({
            id: uid("acc"),
            accountingBookId: bookId,
            accountNumber: entry.accountNumber,
            accountName: entry.accountName,
            accountType: entry.accountType,
            accountSubtype: entry.accountSubtype,
            parentAccountId: null,
            normalBalance: entry.normalBalance,
            currency: "USD",
            isReconciliationAccount: false,
            isSystemAccount: true,
            status: "active",
          });
        }
      });
    };

    const refreshBookSelects = () => {
      const selects = [
        chartBookField,
        journalBookField,
        periodBookField,
        openingBookField,
        financialBookField,
      ];
      selects.forEach((field) => {
        if (!field) return;
        const previous = String(field.value || "");
        field.innerHTML = "";
        const opt = document.createElement("option");
        opt.value = "";
        opt.textContent = isSpanish ? "Selecciona un libro" : "Select a book";
        field.append(opt);
        getSortedBooks().forEach((book) => {
          const item = document.createElement("option");
          item.value = book.id;
          item.textContent = `${book.bookName} (${entityNameById(book.accountingEntityId)})`;
          field.append(item);
        });
        if (previous) {
          field.value = previous;
        }
      });
      syncDependentPickers();
    };

    const syncDependentPickers = () => {
      const selectedBookId = String(journalBookField?.value || "");
      const selectedPeriodBookId = String(periodBookField?.value || selectedBookId);
      const selectedOpeningBookId = String(openingBookField?.value || selectedBookId);
      const selectedFinancialBookId = String(financialBookField?.value || selectedBookId);

      if (chartBookField && String(chartBookField.value || "")) {
        const bookAccounts = getAccountsForBook(String(chartBookField.value));
        populateSelect(chartParentField, bookAccounts.map((entry) => ({ id: entry.id, label: `${entry.accountNumber} - ${entry.accountName}` })), "");
      } else if (chartParentField) {
        chartParentField.innerHTML = "";
      }

      const journalAccounts = getAccountsForBook(selectedBookId);
      populateSelect(journalLineAAccountField, journalAccounts.map((entry) => ({ id: entry.id, label: `${entry.accountNumber} ${entry.accountName}` })), "");
      populateSelect(journalLineBAccountField, journalAccounts.map((entry) => ({ id: entry.id, label: `${entry.accountNumber} ${entry.accountName}` })), "");

      const periodOptions = getPeriodsForBook(selectedPeriodBookId);
      const journalOptions = getPeriodsForBook(selectedBookId);
      populateSelect(journalPeriodField, periodOptions.map((entry) => ({ id: entry.id, label: `${entry.periodNumber} (${periodStatusLabel(entry.status)})` })), "");
      populateSelect(periodBookField, getSortedBooks().map((entry) => ({ id: entry.id, label: entry.bookName })), "");

      const openingAccounts = getAccountsForBook(selectedOpeningBookId);
      populateSelect(openingAccountField, openingAccounts.map((entry) => ({ id: entry.id, label: `${entry.accountNumber} ${entry.accountName}` })), "");

      const ledgerAccounts = getAccountsForBook(selectedFinancialBookId);
      populateSelect(financialLedgerField, ledgerAccounts.map((entry) => ({ id: entry.id, label: `${entry.accountNumber} ${entry.accountName}` })), "");
    };

    const populateSelect = (select, options, fallbackLabel) => {
      if (!select) return;
      const current = String(select.value || "");
      select.innerHTML = "";
      const fallback = document.createElement("option");
      fallback.value = "";
      fallback.textContent = fallbackLabel || (isSpanish ? "Selecciona..." : "Select...");
      select.append(fallback);
      options.forEach((optionData) => {
        const option = document.createElement("option");
        option.value = optionData.id;
        option.textContent = optionData.label;
        select.append(option);
      });
      if (current) select.value = current;
    };

    const normalizeText = (value) => String(value ?? "").trim();

    const renderBookkeepingServices = () => {
      if (!serviceContainer) return;
      serviceContainer.innerHTML = (Array.isArray(bookkeepingServices) ? bookkeepingServices : [])
        .map(
          (entry) =>
            `<article class="module-item"><h3>${entry.code}</h3><p>${entry.name}</p><p class="module-meta">${isSpanish ? "Base contable" : "Accounting basis"}: ${entry.accountingBasis}</p><p class="module-meta">${isSpanish ? "Frecuencia" : "Frequency"}: ${entry.frequency}</p><p class="module-meta">${isSpanish ? "Estado" : "Status"}: ${serviceStatusLabel(entry.status || (isSpanish ? "borrador" : "draft"))}</p><p class="module-meta">${isSpanish ? "Servicios incluidos" : "Included accounts"}: ${(entry.includedAccounts || []).join(", ")}</p></article>`
        )
        .join("");
    };

    const renderSetups = () => {
      if (!setupContainer) return;
      setupContainer.innerHTML = (Array.isArray(bookkeepingEngagements) ? bookkeepingEngagements : [])
        .map((entry) => {
          const book = accountingBooks.find((bookEntry) => bookEntry.id === entry.accountingBookId);
          const service = bookkeepingServices.find((serviceEntry) => serviceEntry.id === entry.serviceId || serviceEntry.code === entry.serviceCode);
          const status = entry.status || (isSpanish ? "en configuración" : "setup");
          return `<article class="module-item"><h3>${isSpanish ? "Engagement" : "Engagement"}: ${entry.caseNumber || entry.id}</h3><p>${isSpanish ? "Servicio" : "Service"}: ${service?.name || service?.code || entry.serviceId || "-"}</p><p>${isSpanish ? "Entidad" : "Entity"}: ${entityNameById(entry.organizationId) || entityNameById(book?.accountingEntityId) || "-"}</p><p>${isSpanish ? "Libro" : "Book"}: ${bookNameById(entry.accountingBookId)}</p><p>${isSpanish ? "Tipo de libro" : "Book type"}: ${book?.bookType || "-"}</p><p>${isSpanish ? "Estado" : "Status"}: ${status}</p><p class="module-meta">${isSpanish ? "Base" : "Basis"}: ${entry.accountingBasis || (isSpanish ? "sin definir" : "pending")}</p></article>`;
        })
        .join("");
    };

    const renderChartAccounts = () => {
      if (!chartContainer) return;
      chartContainer.innerHTML = (Array.isArray(chartAccounts) ? chartAccounts : [])
        .map(
          (entry) =>
            `<article class="module-item"><h3>${entry.accountNumber} - ${entry.accountName}</h3><p>${isSpanish ? "Libro" : "Book"}: ${bookNameById(entry.accountingBookId)}</p><p>${isSpanish ? "Tipo" : "Type"}: ${entry.accountType} • ${isSpanish ? "Saldo normal" : "Normal"}: ${entry.normalBalance}</p><p class="module-meta">${isSpanish ? "Estado" : "Status"}: ${entry.status} ${entry.isSystemAccount ? "• " + (isSpanish ? "Cuenta sistema" : "System") : ""}</p></article>`
        )
        .join("");
    };

    const renderPeriods = () => {
      if (!periodContainer) return;
      const perms = permissionsFor(getRole());
      periodContainer.innerHTML = (Array.isArray(accountingPeriods) ? accountingPeriods : [])
        .map((entry) => {
          const book = accountingBooks.find((bookEntry) => bookEntry.id === entry.accountingBookId);
          const actions = [];
          if (entry.status === "open" && perms.canManageSetup) actions.push(`<button data-id="${entry.id}" data-action="soft-close" type="button" class="action-link action-link--secondary">${isSpanish ? "Cierre suave" : "Soft close"}</button>`);
          if ((entry.status === "open" || entry.status === "soft_closed") && perms.canManageSetup) actions.push(`<button data-id="${entry.id}" data-action="close" type="button" class="action-link action-link--secondary">${isSpanish ? "Cierre total" : "Close hard"}</button>`);
          if (entry.status === "closed" && perms.canManageSetup) actions.push(`<button data-id="${entry.id}" data-action="reopen" type="button" class="action-link action-link--secondary">${isSpanish ? "Reabrir" : "Reopen"}</button>`);
          return `<article class="module-item"><h3>${entry.periodNumber}</h3><p>${isSpanish ? "Libro" : "Book"}: ${book?.bookName || "-"}</p><p>${isSpanish ? "Tipo" : "Type"}: ${entry.periodType}</p><p>${isSpanish ? "Inicio" : "Start"}: ${entry.startDate} • ${isSpanish ? "Fin" : "End"}: ${entry.endDate}</p><p>${isSpanish ? "Estado" : "Status"}: ${periodStatusLabel(entry.status)}</p><p class="module-meta">${entry.closeVersion ? `Close version: ${entry.closeVersion}` : ""} ${actions.join(" ")}</p></article>`;
        })
        .join("");
    };

    const renderOpeningBalances = () => {
      if (!openingContainer) return;
      openingContainer.innerHTML = (Array.isArray(openingBalances) ? openingBalances : [])
        .map((entry) => {
          const account = chartAccounts.find((account) => account.id === entry.accountId);
          return `<article class="module-item"><h3>${isSpanish ? "Saldo inicial" : "Opening balance"}</h3><p>${isSpanish ? "Cuenta" : "Account"}: ${account?.accountName || entry.accountId}</p><p>${isSpanish ? "Importe" : "Amount"}: ${toLocaleMoney(entry.amount || 0)} • ${isSpanish ? "Fecha" : "Date"}: ${entry.effectiveDate}</p><p class="module-meta">${isSpanish ? "Estado verificación" : "Verification status"}: ${verificationLabel(entry.verificationStatus)}</p><p class="module-meta">${isSpanish ? "Origen" : "Source"}: ${entry.sourceType}</p></article>`;
        })
        .join("");
    };

    const renderFinancials = () => {
      if (!financialContainer) return;
      financialContainer.innerHTML = (Array.isArray(financialAccounts) ? financialAccounts : [])
        .map(
          (entry) =>
            `<article class="module-item"><h3>${entry.displayName}</h3><p>${isSpanish ? "Institución" : "Institution"}: ${entry.institutionName}</p><p>${isSpanish ? "Tipo" : "Type"}: ${entry.accountType} • ${isSpanish ? "Conexión" : "Connection"}: ${entry.connectionType || "-"}</p><p>${isSpanish ? "Propietario" : "Ownership"}: ${ownershipLabel(entry.ownership || "unknown")} • ${isSpanish ? "Estado" : "Status"}: ${entry.status}</p><p>${isSpanish ? "Cuenta contable ligada" : "Linked ledger account"}: ${chartAccounts.find((account) => account.id === entry.ledgerAccountId)?.accountName || "-"}</p></article>`
        )
        .join("");
    };

    const renderJournalEntries = () => {
      if (!journalContainer) return;
      const perms = permissionsFor(getRole());
      const entries = Array.isArray(journalEntries) ? journalEntries : [];
      journalContainer.innerHTML = entries
        .map((entry) => {
          const lines = Array.isArray(entry.lines) ? entry.lines : [];
          const totalDebit = lines.reduce((acc, line) => acc + Number(line.debitAmount || 0), 0);
          const totalCredit = lines.reduce((acc, line) => acc + Number(line.creditAmount || 0), 0);
          const book = accountingBooks.find((b) => b.id === entry.accountingBookId);
          const period = accountingPeriods.find((item) => item.id === entry.postingPeriodId);
          const actions = [];
          if (perms.canReview && entry.status !== "posted" && entry.status !== "reversed") {
            actions.push(`<button data-id="${entry.id}" data-action="approve" type="button" class="action-link action-link--secondary">${isSpanish ? "Aprobar" : "Approve"}</button>`);
          }
          if (perms.canPost && entry.status === "approved") {
            actions.push(`<button data-id="${entry.id}" data-action="post" type="button" class="action-link action-link--secondary">${isSpanish ? "Publicar" : "Post"}</button>`);
          }
          if (perms.canPost && entry.status === "posted") {
            actions.push(`<button data-id="${entry.id}" data-action="reverse" type="button" class="action-link action-link--secondary">${isSpanish ? "Revertir" : "Reverse"}</button>`);
          }
          if ((entry.status === "draft" || entry.status === "voided" || entry.status === "reversed") && perms.canManageSetup) {
            actions.push(`<button data-id="${entry.id}" data-action="delete" type="button" class="action-link action-link--secondary">${isSpanish ? "Eliminar" : "Delete"}</button>`);
          }
          return `<article class="module-item"><h3>${entry.journalNumber}</h3><p>${isSpanish ? "Libro" : "Book"}: ${book?.bookName || "-"}</p><p>${isSpanish ? "Periodo" : "Period"}: ${period?.periodNumber || "-"}</p><p>${isSpanish ? "Fecha" : "Date"}: ${entry.entryDate} • ${isSpanish ? "Estado" : "Status"}: ${journalStatusLabel(entry.status)}</p><p>${isSpanish ? "Descripción" : "Description"}: ${entry.description}</p><p>${isSpanish ? "Partidas" : "Entries"}: ${lines.length} • ${isSpanish ? "Total débitos" : "Total debits"}: ${toLocaleMoney(totalDebit)} • ${isSpanish ? "Total créditos" : "Total credits"}: ${toLocaleMoney(totalCredit)}</p><p class="module-meta">${actions.join(" ")}</p></article>`;
        })
        .join("");
    };

    const createJournalLine = (accountValue, debitField, creditField) => {
      const accountId = toText(accountValue);
      const debit = toMoneyNum(debitField?.value);
      const credit = toMoneyNum(creditField?.value);
      if (!accountId) return null;
      if (!debit && !credit) return null;
      if (debit > 0 && credit > 0) return "invalid";
      return {
        id: uid("je-line"),
        accountId,
        debitAmount: debit,
        creditAmount: credit,
        memo: "",
        clientOrVendorReference: null,
        classReference: null,
        taxMappingCode: null,
        sourceEvidenceReference: null,
      };
    };

    const renderAudit = () => {
      if (!auditLogContainer) return;
      auditLogContainer.innerHTML = (Array.isArray(auditLog) ? auditLog : [])
        .slice(0, 40)
        .map(
          (entry) =>
            `<article class="module-item"><h3>${entry.action || "action"}</h3><p>${asDateTime(entry.at || nowStamp())} • ${entry.role || "-"}</p><p>${entry.details || "-"}</p></article>`
        )
        .join("");
    };

    const getAccountingBookFromService = (serviceValue) => bookkeepingServices.find((entry) => entry.code === serviceValue || entry.name === serviceValue);
    const normalizeBasis = (value) => {
      const valueText = toText(value);
      return valueText === "accrual" || valueText === "modified_cash" || valueText === "external_system_defined" ? valueText : "cash";
    };

    const persistAll = () => {
      const payload = currentBookkeepingState();
      persistBookkeepingLegacy(payload);
      requestApi("admin-bookkeeping", { state: payload }, "PATCH");
      renderAll();
    };

    const renderAll = () => {
      syncDependentPickers();
      renderBookkeepingServices();
      renderSetups();
      renderChartAccounts();
      renderPeriods();
      renderOpeningBalances();
      renderFinancials();
      renderJournalEntries();
      renderAudit();
      updateRoleNote();
    };

    serviceForm?.addEventListener("submit", (event) => {
      const perms = permissionsFor(getRole());
      if (!perms.canManageSetup) return;
      event.preventDefault();
      const code = toText(serviceCodeField?.value).toLowerCase();
      const name = toText(serviceNameField?.value) || (isSpanish ? "Servicio sin nombre" : "Untitled service");
      const basis = normalizeBasis(serviceBasisField?.value);
      if (!code || !name) return;
      const existing = bookkeepingServices.find((entry) => entry.code === code);
      if (existing) {
        appendAudit("bookkeeping_service_duplicate_blocked", isSpanish ? `Intento de duplicar servicio: ${code}` : `Duplicate service prevented: ${code}`);
        if (serviceCodeField) serviceCodeField.value = "";
        if (serviceNameField) serviceNameField.value = "";
        return;
      }
      bookkeepingServices.push({
        id: uid("svc"),
        code,
        name,
        accountingBasis: basis,
        frequency: "monthly",
        includedAccounts: ["asset", "liability", "equity", "income", "expense"],
        includedEntities: [],
        reportingFrequency: "monthly",
        closePolicyId: getDefaultClosePolicy("monthly"),
        taxIntegrationEnabled: true,
        status: isSpanish ? "borrador" : "draft",
      });
      if (serviceCodeField) serviceCodeField.value = "";
      if (serviceNameField) serviceNameField.value = "";
      appendAudit(
        "bookkeeping_service_created",
        isSpanish ? `Servicio creado: ${code} (${name})` : `Service created: ${code} (${name})`
      );
      persistAll();
    });

    setupForm?.addEventListener("submit", (event) => {
      const perms = permissionsFor(getRole());
      if (!perms.canManageSetup) return;
      event.preventDefault();
      const serviceCode = toText(setupServiceField?.value);
      const clientType = toText(setupClientTypeField?.value) || "individual";
      const entityName = toText(setupEntityField?.value) || (isSpanish ? "Entidad sin nombre" : "Unnamed entity");
      const bookName = toText(setupBookNameField?.value) || (isSpanish ? "Libro principal" : "Primary book");
      const bookType = toText(setupBookTypeField?.value) || "primary";
      const basis = normalizeBasis(setupAccountingBasisField?.value);

      let service = getAccountingBookFromService(serviceCode);
      if (!service) {
        service = {
          id: uid("svc"),
          code: serviceCode || (isSpanish ? "bookkeeping_manual" : "bookkeeping_manual"),
          name: serviceCode || (isSpanish ? "Bookkeeping manual" : "Manual bookkeeping"),
          accountingBasis: basis,
          frequency: "monthly",
          includedAccounts: ["asset", "liability", "equity", "income", "expense"],
          includedEntities: [entityName],
          reportingFrequency: "monthly",
          closePolicyId: getDefaultClosePolicy("monthly"),
          taxIntegrationEnabled: true,
        };
        bookkeepingServices.push(service);
      }

      const existingEntity = accountingEntities.find((entity) => entity.displayName === entityName && entity.legalEntityType === clientType);
      const conflictingEntity = accountingEntities.find((entity) => entity.displayName === entityName && entity.legalEntityType !== clientType);
      if (conflictingEntity) {
        appendAudit(
          "bookkeeping_entity_conflict",
          isSpanish ? `Intento de mezcla de entidad: ${entityName}` : `Entity mixing attempt: ${entityName}`
        );
      }
      const entity = existingEntity || (() => {
        const created = {
          id: uid("entity"),
          organizationId: "org-default",
          legalEntityType: clientType,
          displayName: entityName,
          taxIdentifierToken: `token-${Date.now()}`,
          defaultCurrency: "USD",
          country: "US",
          baseJurisdiction: "DE",
          fiscalYearEnd: "12-31",
          status: "active",
        };
        accountingEntities.push(created);
        return created;
      })();

      const newBook = {
        id: uid("book"),
        accountingEntityId: entity.id,
        bookName: bookName,
        bookType: bookType || "primary",
        accountingBasis: basis,
        baseCurrency: "USD",
        fiscalYearEnd: "12-31",
        chartOfAccountsVersionId: `${entity.id}-v1`,
        status: "active",
        openedAt: new Date().toISOString().slice(0, 10),
        closedAt: null,
      };
      accountingBooks.push(newBook);
      ensureSystemBookSetup(newBook.id);

      const engagement = {
        id: uid("kb-case"),
        caseNumber: `BK-${randomInt(9999)}`,
        engagementId: uid("eng"),
        organizationId: entity.id,
        serviceOrderId: uid("order"),
        serviceId: service.id,
        accountingBookId: newBook.id,
        assignedBookkeeperId: "bk-internal",
        assignedReviewerId: "bk-reviewer",
        currentPeriodId: null,
        status: "setup_pending",
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        bookkeepingFrequency: service.frequency || "monthly",
        accountingBasis: basis,
        bookStartDate: newBook.openedAt,
        fiscalYearEnd: newBook.fiscalYearEnd,
        includedAccounts: service.includedAccounts || [],
        includedEntities: [entityName],
        monthlyTransactionAllowance: 500,
        reportingFrequency: service.reportingFrequency || "monthly",
        closePolicyId: service.closePolicyId || getDefaultClosePolicy("monthly"),
        taxIntegrationEnabled: service.taxIntegrationEnabled !== false,
        externalAccountingSystem: null,
      };
      bookkeepingEngagements.push(engagement);

      if (setupServiceField) setupServiceField.value = "";
      if (setupEntityField) setupEntityField.value = "";
      if (setupBookNameField) setupBookNameField.value = "";
      appendAudit(
        "bookkeeping_engagement_created",
        isSpanish
          ? `Engagement creado para ${entity.displayName} con libro ${newBook.bookName}`
          : `Engagement created for ${entity.displayName} with book ${newBook.bookName}`
      );
      persistAll();
    });

    chartForm?.addEventListener("submit", (event) => {
      const perms = permissionsFor(getRole());
      if (!perms.canManageSetup) return;
      event.preventDefault();
      const bookId = toText(chartBookField?.value);
      const accountNumber = toText(chartAccountNumberField?.value);
      const accountName = toText(chartAccountNameField?.value);
      const accountType = toText(chartAccountTypeField?.value);
      const parentAccountId = toText(chartParentField?.value) || null;
      const isSystem = Boolean(chartSystemField?.checked);
      if (!bookId || !accountNumber || !accountName) return;
      const duplicateAccount = chartAccounts.find((entry) => entry.accountingBookId === bookId && entry.accountNumber === accountNumber);
      if (duplicateAccount) {
        if (journalHint) journalHint.textContent = isSpanish ? "Ese número de cuenta ya existe para este libro." : "That account number already exists for this book.";
        return;
      }
      chartAccounts.push({
        id: uid("acc"),
        accountingBookId: bookId,
        accountNumber,
        accountName,
        accountType,
        accountSubtype: accountType === "asset" ? "current_asset" : "general",
        parentAccountId: parentAccountId || null,
        normalBalance: normalBalanceByAccountType(accountType),
        currency: "USD",
        isReconciliationAccount: false,
        isSystemAccount: isSystem,
        status: "active",
      });
      if (chartAccountNumberField) chartAccountNumberField.value = "";
      if (chartAccountNameField) chartAccountNameField.value = "";
      if (chartSystemField) chartSystemField.checked = false;
      appendAudit(
        "bookkeeping_chart_account_created",
        isSpanish ? `Cuenta agregada: ${accountNumber} (${accountName})` : `Chart account added: ${accountNumber} (${accountName})`
      );
      persistAll();
    });

    journalForm?.addEventListener("submit", (event) => {
      const perms = permissionsFor(getRole());
      if (!perms.canManageSetup) return;
      event.preventDefault();
      if (journalHint) journalHint.textContent = "";

      const accountingBookId = toText(journalBookField?.value);
      const postingPeriodId = toText(journalPeriodField?.value);
      const entryDate = toText(journalDateField?.value);
      const description = toText(journalDescriptionField?.value);
      if (!accountingBookId || !postingPeriodId || !description) return;

      const lineA = createJournalLine(journalLineAAccountField?.value, journalLineADebitField, journalLineACreditField);
      const lineB = createJournalLine(journalLineBAccountField?.value, journalLineBDebitField, journalLineBCreditField);
      const entries = [];
      if (lineA === "invalid" || lineB === "invalid" || (!lineA && !lineB)) {
        if (journalHint) journalHint.textContent = isSpanish ? "Cada línea debe tener al menos un importe y no ambos lados." : "Each line must have at least one amount and not both debit and credit.";
        return;
      }
      if (lineA) entries.push(lineA);
      if (lineB) entries.push(lineB);
      const totalDebit = entries.reduce((total, line) => total + Number(line.debitAmount || 0), 0);
      const totalCredit = entries.reduce((total, line) => total + Number(line.creditAmount || 0), 0);
      if (Math.abs(totalDebit - totalCredit) > 0.009) {
        if (journalHint) journalHint.textContent = isSpanish ? "El asiento debe estar balanceado (débitos = créditos)." : "Entry must balance (debits = credits).";
        return;
      }

      const period = accountingPeriods.find((entry) => entry.id === postingPeriodId);
      if (!period || !["open", "reopened"].includes(period.status)) {
        if (journalHint) journalHint.textContent = isSpanish ? "No se puede publicar en período cerrado." : "Cannot post to closed period.";
        return;
      }

      const role = getRole();
      journalEntries.push({
        id: uid("je"),
        accountingBookId,
        journalNumber: nextNumber("JE"),
        entryDate: entryDate || new Date().toISOString().slice(0, 10),
        postingPeriodId,
        description,
        sourceType: "manual",
        sourceReferenceId: role,
        status: role === "bookkeeping_manager" ? "approved" : "draft",
        preparedBy: role,
        reviewedBy: null,
        postedAt: null,
        createdAt: new Date().toISOString(),
        lines: entries,
      });
      if (journalDateField) journalDateField.value = "";
      if (journalDescriptionField) journalDescriptionField.value = "";
      if (journalLineADebitField) journalLineADebitField.value = "";
      if (journalLineACreditField) journalLineACreditField.value = "";
      if (journalLineBDebitField) journalLineBDebitField.value = "";
      if (journalLineBCreditField) journalLineBCreditField.value = "";
      if (journalHint)
        journalHint.textContent = isSpanish ? "Asiento creado en borrador (revisión antes de publicar)." : "Entry created as draft (review before posting).";
      appendAudit(
        "bookkeeping_journal_entry_created",
        isSpanish
          ? `Asiento creado en libro ${bookNameById(accountingBookId)} con ${entries.length} línea(s).`
          : `Journal entry created on book ${bookNameById(accountingBookId)} with ${entries.length} line(s).`
      );
      persistAll();
    });

    periodForm?.addEventListener("submit", (event) => {
      const perms = permissionsFor(getRole());
      if (!perms.canManageSetup) return;
      event.preventDefault();
      const accountingBookId = toText(periodBookField?.value);
      const periodType = toText(periodTypeField?.value) || "monthly";
      const periodNumber = toText(periodNumberField?.value);
      const startDate = toText(periodStartField?.value);
      const endDate = toText(periodEndField?.value);
      if (!accountingBookId || !periodNumber || !startDate || !endDate) return;

      accountingPeriods.push({
        id: uid("period"),
        accountingBookId,
        periodType,
        periodNumber,
        startDate,
        endDate,
        fiscalYear: String(startDate).slice(0, 4),
        status: "open",
        closeVersion: null,
        createdAt: new Date().toISOString(),
      });
      appendAudit("bookkeeping_period_created", isSpanish ? `Período creado: ${periodNumber}` : `Period created: ${periodNumber}`);
      if (periodBookField) periodBookField.value = "";
      if (periodNumberField) periodNumberField.value = "";
      if (periodStartField) periodStartField.value = "";
      if (periodEndField) periodEndField.value = "";
      persistAll();
    });

    periodContainer?.addEventListener("click", (event) => {
      const target = event.target;
      const perms = permissionsFor(getRole());
      if (!(target instanceof HTMLButtonElement)) return;
      const id = String(target.dataset.id || "");
      const action = String(target.dataset.action || "");
      if (!id || !action) return;
      const period = accountingPeriods.find((entry) => entry.id === id);
      if (!period) return;
      if (!perms.canManageSetup) return;
      if (action === "soft-close" && period.status === "open") {
        period.status = "soft_closed";
        period.closeVersion = `soft-${Date.now()}`;
        appendAudit("bookkeeping_period_soft_closed", `${isSpanish ? "Cierre suave" : "Soft close"}: ${period.periodNumber}`);
      }
      if (action === "close" && (period.status === "open" || period.status === "soft_closed")) {
        period.status = "closed";
        period.closeVersion = `v${Date.now()}`;
        appendAudit("bookkeeping_period_hard_closed", `${isSpanish ? "Cierre total" : "Hard close"}: ${period.periodNumber}`);
      }
      if (action === "reopen" && period.status === "closed") {
        period.status = "reopened";
        period.closeVersion = `reopen-${Date.now()}`;
        appendAudit("bookkeeping_period_reopened", `${isSpanish ? "Reapertura de período" : "Period reopened"}: ${period.periodNumber}`);
      }
      persistAll();
    });

    openingForm?.addEventListener("submit", (event) => {
      const perms = permissionsFor(getRole());
      if (!perms.canManageSetup) return;
      event.preventDefault();
      const accountingBookId = toText(openingBookField?.value);
      const accountId = toText(openingAccountField?.value);
      const amount = toMoneyNum(openingAmountField?.value);
      const effectiveDate = toText(openingDateField?.value);
      const sourceType = toText(openingSourceField?.value);
      const verificationStatus = toText(openingVerificationField?.value);
      if (!accountingBookId || !accountId || !effectiveDate || !Number.isFinite(amount)) return;

      const book = accountingBooks.find((entry) => entry.id === accountingBookId);
      if (!book) return;

      openingBalances.push({
        id: uid("ob"),
        accountId,
        effectiveDate,
        amount,
        sourceType,
        sourceDocumentId: `local-${Date.now()}`,
        verificationStatus: verificationStatus || "unverified",
        preparedBy: getRole(),
        reviewedBy: null,
      });
      appendAudit(
        "bookkeeping_opening_balance_created",
        isSpanish ? `Saldo inicial creado para cuenta ${accountId}` : `Opening balance created for account ${accountId}`
      );
      if (openingDateField) openingDateField.value = "";
      if (openingAmountField) openingAmountField.value = "";
      if (openingBookField) openingBookField.value = "";
      persistAll();
    });

    financialForm?.addEventListener("submit", (event) => {
      const perms = permissionsFor(getRole());
      if (!perms.canManageSetup) return;
      event.preventDefault();
      const accountingBookId = toText(financialBookField?.value);
      const institutionName = toText(financialInstitutionField?.value);
      const displayName = toText(financialDisplayField?.value);
      const accountType = toText(financialTypeField?.value) || "checking";
      const ownership = toText(financialOwnershipField?.value) || "business_owned";
      const connectionType = toText(financialConnectionField?.value) || "manual_entry";
      const ledgerAccountId = toText(financialLedgerField?.value);
      if (!accountingBookId || !institutionName || !displayName || !ledgerAccountId) return;

      financialAccounts.push({
        id: uid("fin"),
        accountingBookId,
        institutionName,
        displayName,
        accountType,
        maskedAccountNumber: `****-${randomInt(9000) + 1000}`,
        ledgerAccountId,
        connectionType,
        statementFrequency: "monthly",
        reconciliationEnabled: ownership === "business_owned" ? true : false,
        status: "active",
        createdAt: new Date().toISOString().slice(0, 10),
        ownership,
        statementSource: connectionType === "manual_statement" ? "manual_statement" : connectionType,
      });
      appendAudit(
        "bookkeeping_financial_account_created",
        isSpanish ? `Cuenta financiera registrada: ${displayName}` : `Financial account registered: ${displayName}`
      );
      if (financialInstitutionField) financialInstitutionField.value = "";
      if (financialDisplayField) financialDisplayField.value = "";
      if (financialBookField) financialBookField.value = "";
      persistAll();
    });

    journalContainer?.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      const id = String(target.dataset.id || "");
      const action = String(target.dataset.action || "");
      if (!id || !action) return;
      const perms = permissionsFor(getRole());
      const entry = journalEntries.find((record) => record.id === id);
      if (!entry) return;
      if (action === "approve" && perms.canReview && ["draft", "review_required"].includes(entry.status)) {
        entry.status = "approved";
        entry.reviewedBy = getRole();
        appendAudit("bookkeeping_journal_approved", `${isSpanish ? "Asiento aprobado" : "Journal approved"}: ${entry.journalNumber}`);
      }
      if (action === "post" && perms.canPost && entry.status === "approved") {
        entry.status = "posted";
        entry.postedAt = new Date().toISOString();
        appendAudit("bookkeeping_journal_posted", `${isSpanish ? "Asiento publicado" : "Journal posted"}: ${entry.journalNumber}`);
      }
      if (action === "reverse" && perms.canPost && entry.status === "posted") {
        entry.status = "reversed";
        const reversalLines = (Array.isArray(entry.lines) ? entry.lines : []).map((line) => ({
          id: uid("je-line"),
          accountId: line.accountId,
          debitAmount: Number(line.creditAmount || 0),
          creditAmount: Number(line.debitAmount || 0),
          memo: `${isSpanish ? "Reverso de " : "Reversal of "} ${entry.journalNumber}`,
          clientOrVendorReference: line.clientOrVendorReference || null,
          classReference: line.classReference || null,
          taxMappingCode: line.taxMappingCode || null,
          sourceEvidenceReference: line.sourceEvidenceReference || null,
        }));
        journalEntries.push({
          id: uid("je"),
          accountingBookId: entry.accountingBookId,
          journalNumber: `${entry.journalNumber}-R`,
          entryDate: new Date().toISOString().slice(0, 10),
          postingPeriodId: entry.postingPeriodId,
          description: `${isSpanish ? "Reverso de" : "Reversal of"} ${entry.journalNumber}`,
          sourceType: "manual",
          sourceReferenceId: getRole(),
          status: "posted",
          preparedBy: getRole(),
          reviewedBy: entry.reviewedBy || getRole(),
          postedAt: new Date().toISOString(),
          createdAt: new Date().toISOString(),
          lines: reversalLines,
        });
        appendAudit("bookkeeping_journal_reversed", `${isSpanish ? "Asiento revertido" : "Journal reversed"}: ${entry.journalNumber}`);
      }
      if (action === "delete" && perms.canManageSetup) {
        const index = journalEntries.findIndex((record) => record.id === id);
        if (index > -1) {
          journalEntries.splice(index, 1);
          appendAudit("bookkeeping_journal_deleted", `${isSpanish ? "Asiento eliminado" : "Journal deleted"}: ${entry.journalNumber}`);
        }
      }
      persistAll();
    });

    chartBookField?.addEventListener("change", syncDependentPickers);
    journalBookField?.addEventListener("change", syncDependentPickers);
    openingBookField?.addEventListener("change", syncDependentPickers);
    financialBookField?.addEventListener("change", syncDependentPickers);
    roleSelect?.addEventListener("change", updateRoleNote);

    setupReviewBtn?.addEventListener("click", () => {
      const perms = permissionsFor(getRole());
      if (!perms.canReview) {
        if (journalHint) journalHint.textContent = isSpanish ? "Rol sin permisos de revisión." : "Role does not have review permissions.";
        return;
      }
      if (aiContainer) {
        const now = new Date().toLocaleString(locale === "es" ? "es-ES" : "en-US");
        aiContainer.innerHTML = `<article class="module-item"><h3>${isSpanish ? "Revisión solicitada" : "Review requested"}</h3><p>${isSpanish ? "Checklist de setup solicitado para aprobación de manager/QA." : "Setup checklist review requested for manager/QA."} • ${now}</p></article>`;
      }
      appendAudit("bookkeeping_setup_review_requested", isSpanish ? "Revisión de setup solicitada." : "Setup review requested.");
    });

    aiSimulateBtn?.addEventListener("click", () => {
      if (!aiContainer) return;
      const suggestions = [
        isSpanish ? "Sugerencia: validar cuentas de entrada/salida y separar personal/empresa." : "Suggestion: validate in/out accounts and separate personal/business usage.",
        isSpanish ? "Sugerencia: iniciar con período mensual y activar cierre suave al cierre de ciclo." : "Suggestion: start with monthly periods and use soft-close at end of cycle.",
        isSpanish ? "Sugerencia: configurar chart de cuentas mínimo con activo, pasivo, ingresos y gastos para evitar cuentas genéricas." : "Suggestion: configure minimum chart with assets, liabilities, income and expenses to avoid generic accounts.",
      ];
      const suggestion = suggestions[randomInt(suggestions.length)];
      aiContainer.innerHTML = `<article class="module-item"><h3>${isSpanish ? "IA (simulación)" : "AI (simulation)"}</h3><p>${suggestion}</p></article>`;
      appendAudit("bookkeeping_ai_simulation", isSpanish ? "Sugerencia IA ejecutada." : "AI suggestion executed.");
    });

    reopenBtn?.addEventListener("click", () => {
      const perms = permissionsFor(getRole());
      const closedPeriod = accountingPeriods.find((entry) => entry.status === "closed");
      if (!closedPeriod) {
        if (journalHint) journalHint.textContent = isSpanish ? "No hay periodo cerrado para reabrir." : "No closed period found to reopen.";
        return;
      }
      if (!perms.canManageSetup) {
        if (journalHint) journalHint.textContent = isSpanish ? "Cliente o rol lector no puede reabrir. Solicita a un manager." : "Client/read-only role cannot reopen. Ask a manager.";
        return;
      }
      closedPeriod.status = "reopened";
      closedPeriod.closeVersion = `reopen-${Date.now()}`;
      appendAudit("bookkeeping_period_reopen_requested", isSpanish ? "Reapertura solicitada." : "Period reopen requested.");
      persistAll();
    });

    const bootstrapBookkeepingState = () => {
      const fallbackState = currentBookkeepingState();
      loadModuleState("admin-bookkeeping", STORAGE_KEYS.adminBookkeeping, fallbackState)
        .then((remoteState) => {
          hydrateBookkeepingFromState(remoteState);
          persistBookkeepingLegacy(currentBookkeepingState());
        })
        .catch(() => {
          persistBookkeepingLegacy(fallbackState);
        })
        .finally(() => {
          refreshBookSelects();
          renderAll();
        });
    };
    bootstrapBookkeepingState();
  }

})();
</script>


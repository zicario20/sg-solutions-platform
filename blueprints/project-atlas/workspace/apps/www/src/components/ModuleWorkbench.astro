        .reduce((sum, invoice) => sum + Number(invoice.amount || 0), 0);
      const pendingTotal = invoices
        .filter((invoice) => invoice.status === (locale === "es" ? "pendiente" : "pending"))
        .reduce((sum, invoice) => sum + Number(invoice.amount || 0), 0);

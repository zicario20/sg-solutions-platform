  const sessionEndpoint = "/session";
  let sessionRequestPromise: Promise<{ token: string; role: string } | null> | null = null;

  const normalizeAdminRole = (value: unknown): string => {
    const candidate = String(value ?? "owner").trim().toLowerCase();
    return adminRoles.includes(candidate) ? candidate : "owner";
  };

  const getStoredAdminAuth = () => {
    if (surface !== "admin" || !API_BASE) return null;
    try {
      const token = String(localStorage.getItem(storageTokenKey) || "").trim();
      if (!token) return null;

      const role = normalizeAdminRole(localStorage.getItem(storageRoleKey));
      return { token, role };
    } catch {
      return null;
    }
  };

  const parseAdminTokenExpiration = (token: string): number | null => {
    try {
      const rawParts = String(token).split(".");
      const rawPayload = rawParts[1];
      if (!rawPayload) return null;
      const base64Payload = rawPayload.replace(/-/g, "+").replace(/_/g, "/");
      const paddedPayload = `${base64Payload}${"=".repeat((4 - (base64Payload.length % 4)) % 4)}`;
      const payload = JSON.parse(atob(paddedPayload));
      const rawExpiration = Number(payload?.exp);
      return Number.isFinite(rawExpiration) ? rawExpiration : null;
    } catch {
      return null;
    }
  };

  const isTokenExpired = (token: string) => {
    const exp = parseAdminTokenExpiration(token);
    return !exp || exp <= Math.floor(Date.now() / 1000);
  };

  const clearAdminSession = () => {
    if (typeof localStorage === "undefined") return;
    localStorage.removeItem(storageTokenKey);
    localStorage.removeItem(storageRoleKey);
  };


      if (!action || !id) return;
      const current = appointments.find((entry) => entry.id === id);
      if (!current) return;
      if (action === "reschedule") {
        current.status = locale === "es" ? "reprogramada" : "rescheduled";
        const dt = new Date(current.date);
        if (Number.isFinite(dt.getTime())) {
          dt.setDate(dt.getDate() + 1);
          current.date = dt.toISOString().slice(0, 16);
        }
      }
      if (action === "cancel") {
        current.status = locale === "es" ? "cancelada" : "canceled";

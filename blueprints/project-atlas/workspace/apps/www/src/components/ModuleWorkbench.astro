      const headers = {
        "x-atlas-surface": "admin",
        ...(adminAuth ? { "x-admin-role": adminAuth.role } : {}),
        ...(adminAuth ? { "x-admin-token": adminAuth.token } : {}),
      } as Record<string, string>;

      const init = {
        method,
        headers: method === "GET" ? headers : { ...headers, "Content-Type": "application/json" },
        ...(method === "GET" ? {} : { body: toPayload(payload) }),
      };
      return await fetch(`${API_BASE}${normalizedPath}`, init);
    };

    let adminAuth = await getAdminAuth();
    let response = await sendRequest(adminAuth);

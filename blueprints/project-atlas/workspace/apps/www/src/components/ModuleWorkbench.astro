        `<article class="module-item"><h3>${isSpanish ? "Resumen" : "Summary"}</h3><p>${isSpanish ? "Pagado" : "Paid"}: ${toLocaleMoney(paidTotal)}</p><p>${isSpanish ? "Pendiente" : "Pending"}: ${toLocaleMoney(pendingTotal)}</p></article>` +

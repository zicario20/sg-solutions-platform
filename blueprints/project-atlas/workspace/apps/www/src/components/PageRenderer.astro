import { getChromeBySurface } from "../content/site-chrome";
import type { PublicPage } from "../domain/public-site";
import ActionLink from "./ActionLink.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import ContentSection from "./ContentSection.astro";
import Hero from "./Hero.astro";
import TrustRail from "./TrustRail.astro";
import ModuleWorkbench from "./ModuleWorkbench.astro";
import { CLIENT_ROUTE_KEYS, ADMIN_ROUTE_KEYS } from "../content/site-content";

interface Props {
  page: PublicPage;
}
const { page } = Astro.props;
const copy = getChromeBySurface(page.locale, page.surface);
const showUnavailable = page.routeKey === "contact";
const isInteractiveDemo = (() => {
  if (page.surface === "public") {
    return page.routeKey === "help-center" || page.routeKey === "public-forms";
  }
  if (page.surface === "client") {
    return Array.from(CLIENT_ROUTE_KEYS).includes(page.routeKey);
  }
  return Array.from(ADMIN_ROUTE_KEYS).includes(page.routeKey);
})();
---

<Breadcrumbs page={page} />
<Hero page={page} />
{page.routeKey === "home" && <TrustRail locale={page.locale} />}

{page.publicationState === "review-required" && (
  <div class="review-banner" role="status">
    <div class="site-container">
      <strong>{copy.reviewTitle}</strong>
      <span>{copy.reviewBody}</span>
    </div>
  </div>
)}

{isInteractiveDemo ? <ModuleWorkbench routeKey={page.routeKey} locale={page.locale} surface={page.surface} /> : page.sections.map((section, index) => <ContentSection section={section} locale={page.locale} index={index} />)}

{showUnavailable && (
  <section class="integration-notice" aria-labelledby="integration-title">
    <div class="site-container integration-notice__inner">
      <div>
        <p class="eyebrow"><span></span>{copy.integrationEyebrow}</p>
        <h2 id="integration-title">{copy.unavailableTitle}</h2>
        <p>{copy.unavailableBody}</p>
      </div>
      <ActionLink action="quote" locale={page.locale} variant="secondary" />
    </div>
  </section>
)}

<section class="final-cta">
  <div class="site-container final-cta__inner">
    <div>
      <p class="eyebrow eyebrow--light"><span></span>{copy.finalEyebrow}</p>
      <h2>{copy.finalHeading}</h2>
      <p>{copy.finalBody}</p>
    </div>
    <ActionLink action="evaluation" locale={page.locale} />
  </div>
</section>

---
import { SITE_CHROME } from "../content/site-chrome";
import type { PublicPage } from "../domain/public-site";
import ActionLink from "./ActionLink.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import ContentSection from "./ContentSection.astro";
import Hero from "./Hero.astro";
import TrustRail from "./TrustRail.astro";

interface Props {
  page: PublicPage;
}
const { page } = Astro.props;
const copy = SITE_CHROME[page.locale];
const showUnavailable = page.routeKey === "contact";
---

<Breadcrumbs page={page} />
<Hero page={page} />
{page.routeKey === "home" && <TrustRail locale={page.locale} />}

{page.publicationState === "review-required" && (
  <div class="review-banner" role="status">
    <div class="site-container">
      <strong>{page.locale === "es" ? "Revisión requerida" : "Review required"}</strong>
      <span>{page.locale === "es" ? "Este contenido no está aprobado para publicación legal en producción." : "This content is not approved for production legal publication."}</span>
    </div>
  </div>
)}

{page.sections.map((section, index) => <ContentSection section={section} locale={page.locale} index={index} />)}

{showUnavailable && (
  <section class="integration-notice" aria-labelledby="integration-title">
    <div class="site-container integration-notice__inner">
      <div>
        <p class="eyebrow"><span></span>{page.locale === "es" ? "Canal seguro" : "Secure channel"}</p>
        <h2 id="integration-title">{copy.unavailableTitle}</h2>
        <p>{copy.unavailableBody}</p>
      </div>
      <ActionLink action="quote" locale={page.locale} variant="secondary" />
    </div>
  </section>
)}

<section class="final-cta">
  <div class="site-container final-cta__inner">
    <div>
      <p class="eyebrow eyebrow--light"><span></span>{page.locale === "es" ? "El siguiente paso" : "The next step"}</p>
      <h2>{page.locale === "es" ? "Empieza con una conversación clara" : "Start with a clear conversation"}</h2>
      <p>{page.locale === "es" ? "Primero entendemos tu objetivo. Después definimos alcance, información y próximos pasos." : "We first understand your goal. Then we define scope, information and next steps."}</p>
    </div>
    <ActionLink action="evaluation" locale={page.locale} />
  </div>
</section>

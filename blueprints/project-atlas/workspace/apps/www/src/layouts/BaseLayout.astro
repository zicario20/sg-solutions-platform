---
import { readPublicChatConfig } from "@atlas/config";
import ChatExperience from "../components/chat/ChatExperience.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { SITE_CHROME } from "../content/site-chrome";
import type { PublicPage } from "../domain/public-site";
import { createSeoProjection, createStructuredData, serializeStructuredData } from "../lib/seo";
import "../styles/global.css";

interface Props {
  page: PublicPage;
  alternatePath?: string;
  structuredData?: object;
  suppressFloatingChat?: boolean;
}
const {
  page,
  alternatePath,
  structuredData: providedStructuredData,
  suppressFloatingChat = false,
} = Astro.props;
const copy = SITE_CHROME[page.locale];
const origin = Astro.site?.toString() ?? "https://www.sgsllc.com";
const seo = createSeoProjection(page, origin, alternatePath);
const structuredData = providedStructuredData ?? createStructuredData(page, origin, alternatePath);
const serializedStructuredData = serializeStructuredData(structuredData);
const esPage = page.locale === "es" ? seo.canonical : seo.alternate;
const enPage = page.locale === "en" ? seo.canonical : seo.alternate;
const chat = readPublicChatConfig({
  PUBLIC_CHAT_STATE: import.meta.env.PUBLIC_CHAT_STATE,
  PUBLIC_CHAT_ENABLED: import.meta.env.PUBLIC_CHAT_ENABLED,
  PUBLIC_CHAT_CANONICAL_ORIGIN: import.meta.env.PUBLIC_CHAT_CANONICAL_ORIGIN,
  PUBLIC_CHAT_SESSION_TTL_SECONDS: import.meta.env.PUBLIC_CHAT_SESSION_TTL_SECONDS,
  PUBLIC_CHAT_MAX_MESSAGE_CHARACTERS: import.meta.env.PUBLIC_CHAT_MAX_MESSAGE_CHARACTERS,
  PUBLIC_CHAT_ACTIVATION_READY_APPROVAL: import.meta.env.PUBLIC_CHAT_ACTIVATION_READY_APPROVAL,
  PUBLIC_CHAT_OPERATIONAL_APPROVAL: import.meta.env.PUBLIC_CHAT_OPERATIONAL_APPROVAL,
});
---

<!doctype html>
<html lang={page.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#0A2540" />
    <link rel="icon" type="image/jpeg" href="/brand/sg-solutions-logo.jpg" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <meta name="robots" content={page.publicationState === "published" ? "index,follow" : "noindex,follow"} />
    <link rel="canonical" href={seo.canonical} />
    <link rel="alternate" hreflang="es" href={esPage} />
    <link rel="alternate" hreflang="en" href={enPage} />
    <link rel="alternate" hreflang="x-default" href="https://www.sgsllc.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SG Solutions" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={seo.canonical} />
    <meta property="og:locale" content={page.locale === "es" ? "es_US" : "en_US"} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <script type="application/ld+json" set:html={serializedStructuredData}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <SiteHeader page={page} alternatePath={alternatePath} />
    <main id="main-content"><slot /></main>
    <SiteFooter locale={page.locale} />
    {chat.enabled && !suppressFloatingChat && <ChatExperience locale={page.locale} />}
    <script is:inline src="/scripts/mobile-navigation.js" defer></script>
  </body>
</html>

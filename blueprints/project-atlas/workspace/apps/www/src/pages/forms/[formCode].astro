---
import PublicFormExperience from "../../components/forms/PublicFormExperience.astro";
import type { PublicFormRenderProjection } from "../../components/forms/types";
import { getPublicFormStaticPaths } from "../../content/public-forms";
import type { PublicPage } from "../../domain/public-site";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  page: PublicPage;
  projection: PublicFormRenderProjection;
  alternatePath: string;
}

export function getStaticPaths() {
  return getPublicFormStaticPaths("es");
}

const { page, projection, alternatePath } = Astro.props as Props;
---

<BaseLayout page={page} alternatePath={alternatePath} suppressFloatingChat>
  <PublicFormExperience projection={projection} />
</BaseLayout>

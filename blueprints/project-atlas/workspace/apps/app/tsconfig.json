{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "jsx": "preserve",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"],
      "@atlas/*": ["../../packages/*/src/index.ts"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "../../blueprints/**",
    "../../superpowers-main/**",
    "../../ui-ux-pro-max-skill-main/**",
    "../../cyber-neo-main/**",
    "../../the-architect-main/**",
    "node_modules/**"
  ]
}
